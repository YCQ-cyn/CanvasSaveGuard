{
  "manifest_version": 3,
  "name": "画布助手",
  "version": "1.0.43",
  "description": "自动保护画布与生成图片，校验完整 ZIP，按手动删除记录清理缓存，修复图片点击并支持 Shift 框选。",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://canvas.modelaryx.com/*",
    "https://canvas.best/*",
    "https://image.yydsapi.uno/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "画布助手",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://canvas.modelaryx.com/*",
        "https://canvas.best/*"
      ],
      "js": [
        "guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://canvas.modelaryx.com/*",
        "https://canvas.best/*"
      ],
      "js": [
        "cleanup-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "canvas_click_fix",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "patches/canvas-client-v040.js",
        "patches/canvas-client-v020-1.0.43.js"
      ],
      "matches": [
        "https://canvas.modelaryx.com/*",
        "https://canvas.best/*"
      ]
    }
  ]
}
